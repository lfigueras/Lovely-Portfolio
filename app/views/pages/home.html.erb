<div class="bg-[#f6eee4] text-[#1a1a1a]">
  <%# Left page indicator %>
  <nav data-controller="scrollspy" aria-label="Section navigation"
       class="fixed left-5 top-1/2 z-50 hidden -translate-y-1/2 lg:block">
    <ul class="flex flex-col items-center gap-5">
      <% [["home", "Home"], ["about", "About"], ["skills", "Skills"], ["projects", "Projects"], ["contact", "Contact"]].each do |id, label| %>
        <li>
          <a href="#<%= id %>" data-scrollspy-target="dot" data-section="<%= id %>"
             title="<%= label %>" aria-label="<%= label %>"
             class="block h-3 w-3 rounded-full border-2 border-[#1a1a1a]/40 transition-all duration-300"></a>
        </li>
      <% end %>
    </ul>
  </nav>

  <%# ===================== Full-screen landing hero ===================== %>
  <section id="home" class="relative flex min-h-screen snap-start flex-col overflow-hidden bg-[#f6eee4]">
    <%# Navbar %>
    <nav data-controller="nav" class="relative z-10 mx-auto flex w-full max-w-6xl flex-wrap items-center justify-between px-6 py-6 sm:px-10">
        <a href="#" class="flex items-center gap-2 text-xl font-extrabold tracking-tight text-[#1a1a1a]">
          <span class="flex h-6 w-6 items-center justify-center bg-[#e35c2b] text-xs text-white">L</span>
          LOVELY
        </a>
        <div class="hidden items-center gap-8 text-[11px] font-bold uppercase tracking-widest text-[#1a1a1a] md:flex">
          <a href="#" class="border-b-2 border-[#e35c2b] pb-1 text-[#e35c2b]">Home</a>
          <a href="#about" class="hover:text-[#e35c2b]">About</a>
          <a href="#skills" class="hover:text-[#e35c2b]">Skills</a>
          <a href="#projects" class="hover:text-[#e35c2b]">Portfolio</a>
          <a href="#contact" class="hover:text-[#e35c2b]">Contact</a>
        </div>
        <a href="#contact" class="hidden bg-[#e35c2b] px-5 py-2.5 text-[11px] font-bold uppercase tracking-widest text-white hover:bg-[#cf4f22] md:inline-block">Contact Now</a>

        <%# Hamburger (mobile) %>
        <button type="button" data-action="nav#toggle" aria-label="Toggle menu" class="text-[#1a1a1a] md:hidden">
          <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
        </button>

        <%# Mobile menu %>
        <div data-nav-target="menu" class="max-h-0 w-full overflow-hidden opacity-0 transition-all duration-300 ease-out md:hidden">
          <div class="mt-6 flex flex-col items-end gap-4 border-t border-[#1a1a1a]/10 pt-6 text-right text-[11px] font-bold uppercase tracking-widest text-[#1a1a1a]">
            <a href="#" data-action="nav#close" class="text-[#e35c2b]">Home</a>
            <a href="#about" data-action="nav#close" class="hover:text-[#e35c2b]">About</a>
            <a href="#skills" data-action="nav#close" class="hover:text-[#e35c2b]">Skills</a>
            <a href="#projects" data-action="nav#close" class="hover:text-[#e35c2b]">Portfolio</a>
            <a href="#contact" data-action="nav#close" class="hover:text-[#e35c2b]">Contact</a>
            <a href="#contact" data-action="nav#close" class="mt-1 w-fit bg-[#e35c2b] px-5 py-2.5 text-white hover:bg-[#cf4f22]">Contact Now</a>
          </div>
        </div>
      </nav>

      <%# Hero body (fills remaining height) %>
      <div class="relative z-10 mx-auto grid w-full max-w-6xl flex-1 items-center gap-10 px-6 pb-12 sm:px-10 lg:grid-cols-2">
        <%# Left: intro %>
        <div>
          <p class="mb-5 flex items-center gap-2 text-[11px] font-bold uppercase tracking-widest text-[#1a1a1a]">
            <span>✋</span> My name is Lovely
          </p>
          <h1 class="text-5xl font-extrabold leading-none tracking-tight text-[#1a1a1a] sm:text-6xl">
            I&rsquo;m a Developer<span class="ml-1 inline-block h-12 w-[3px] animate-pulse bg-[#1a1a1a] align-middle sm:h-14"></span>
          </h1>
          <div class="mt-8 flex flex-wrap items-center gap-4">
            <a href="#projects" class="inline-block bg-[#e35c2b] px-7 py-3 text-[11px] font-bold uppercase tracking-widest text-white hover:bg-[#cf4f22]">Let&rsquo;s Start</a>
            <a href="/Lovely-Joy-Figueras-Resume.pdf" target="_blank" rel="noopener" class="inline-block border border-[#1a1a1a] px-7 py-3 text-[11px] font-bold uppercase tracking-widest text-[#1a1a1a] hover:bg-[#1a1a1a] hover:text-white">My Resume</a>
          </div>
        </div>

        <%# Right: edited portrait %>
        <div class="relative mx-auto flex h-[420px] w-full max-w-md items-center justify-center">
          <%= image_tag "profile-orange.png", alt: "Illustrated portrait of Lovely Joy Figueras", class: "h-[380px] w-[380px] max-w-full object-contain" %>
        </div>
      </div>
  </section>

  <%# ===================== About ===================== %>
  <section id="about" class="flex min-h-screen snap-start flex-col justify-center">
    <%# About content, centered in the viewport %>
    <div class="mx-auto grid w-full max-w-6xl items-center gap-12 px-6 py-16 sm:px-10 lg:grid-cols-2">
      <%# Left: what I do %>
      <ul class="space-y-12 border-l-2 border-[#e35c2b]/40 pl-10">
        <% [
          { title: "Android Development", icon: "M7 2h10v20H7zM11 18h2" },
          { title: "AI Integration", icon: "M12 3l1.6 4.4L18 9l-4.4 1.6L12 15l-1.6-4.4L6 9l4.4-1.6zM5 16l.8 2.2L8 19l-2.2.8L5 22l-.8-2.2L2 19l2.2-.8z" },
          { title: "Web Development", icon: "M3 12h18M12 3a15 15 0 010 18M12 3a15 15 0 000 18M4 7h16M4 17h16" }
        ].each do |item| %>
          <li class="relative flex items-center gap-4">
            <span class="absolute -left-[46px] top-1/2 h-3 w-3 -translate-y-1/2 bg-[#e35c2b]"></span>
            <span class="flex h-12 w-12 items-center justify-center border border-[#1a1a1a]/15 text-[#e35c2b]">
              <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="<%= item[:icon] %>"/></svg>
            </span>
            <h3 class="text-lg font-bold text-[#1a1a1a]"><%= item[:title].html_safe %></h3>
          </li>
        <% end %>
      </ul>

      <%# Right: about me + stats %>
      <div>
        <h2 class="text-4xl font-extrabold tracking-tight text-[#1a1a1a] sm:text-5xl">About me</h2>
        <p class="mt-6 text-base leading-relaxed text-gray-600">
          I&rsquo;m a Software Engineer with 5 years of experience, focused primarily on Android and mobile
          development, with full-stack web experience as well. I work across the full development lifecycle in
          Agile teams, implementing features, troubleshooting production issues, and shipping fixes safely through
          release. I currently build and refine payment logic around EMV specifications across card brands for
          secure, compliant transactions, and I bring AI into my daily workflow with GitHub Copilot and Claude
          Code. I enjoy owning problems end-to-end, from root cause to production.
        </p>
        <p class="mt-5 text-base leading-relaxed text-gray-600">
          Before writing code, I spent years as a call center agent &mdash; a career I deliberately shifted away
          from to pursue software development. That chapter sharpened the skills I lean on every day: listening
          closely, staying calm under pressure, and explaining complex things in plain language. It&rsquo;s why I
          care as much about the people using what I build as the systems behind it.
        </p>
        <div class="mt-10 grid grid-cols-3 gap-6">
          <% [
            { num: "5", label: "Years of experience" },
            { num: "3", label: "Companies" },
            { num: "600", label: "Training hours" }
          ].each do |stat| %>
            <div>
              <p class="text-3xl font-extrabold text-[#1a1a1a]"><%= stat[:num] %> <span class="text-[#e35c2b]">+</span></p>
              <p class="mt-1 text-xs leading-snug text-gray-500"><%= stat[:label] %></p>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </section>

  <div class="mx-auto max-w-6xl px-6 sm:px-10">

    <%# ===================== Skills & Tools ===================== %>
    <section id="skills" class="flex min-h-screen snap-start scroll-mt-6 flex-col justify-center py-20">
      <div class="mb-12">
        <h2 class="text-4xl font-extrabold tracking-tight text-[#1a1a1a] sm:text-5xl">Building Reliable Software</h2>
        <p class="mt-4 max-w-2xl text-base text-gray-600">I build and ship features for mobile and web products &mdash; from first commit to production deployment.</p>
      </div>

      <div class="grid gap-6 lg:grid-cols-2">
        <%# Card 1: What I can do %>
        <div class="rounded-2xl border border-[#1a1a1a]/10 bg-white/60 p-8 sm:p-10">
          <div class="mb-6 flex items-center gap-3">
            <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-[#e35c2b] text-white">
              <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M8 9l-3 3 3 3m8-6l3 3-3 3M13 5l-2 14"/></svg>
            </span>
            <h3 class="text-xl font-bold text-[#1a1a1a]">What I can do</h3>
          </div>
          <p class="mb-5 text-sm text-gray-600">I help teams build and ship production-ready software:</p>
          <ul class="space-y-3">
            <% ["Mobile App Development", "Payments Integration", "Fullstack Web Development", "REST API Integration", "AI Integration", "CI/CD &amp; Build Automation"].each do |item| %>
              <li class="flex items-center gap-3 text-sm font-semibold text-[#1a1a1a]">
                <span class="h-1.5 w-1.5 flex-none rounded-full bg-[#e35c2b]"></span>
                <%= item.html_safe %>
              </li>
            <% end %>
          </ul>
        </div>

        <%# Card 2: Tools I use %>
        <div class="rounded-2xl border border-[#1a1a1a]/10 bg-white/60 p-8 sm:p-10">
          <div class="mb-6 flex items-center gap-3">
            <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-[#e35c2b] text-white">
              <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l9 5-9 5-9-5 9-5zM3 12l9 5 9-5M3 17l9 5 9-5"/></svg>
            </span>
            <h3 class="text-xl font-bold text-[#1a1a1a]">Tools I Use</h3>
          </div>
          <p class="mb-5 text-sm text-gray-600">I use proven tools and technologies to build reliable products:</p>
          <ul class="space-y-4">
            <% [
              { group: "Mobile", tools: "Kotlin, Java, Android, Jetpack Compose, MVVM" },
              { group: "Web", tools: "Ruby on Rails, Hotwire, JavaScript, Tailwind, Alpine.js" },
              { group: "Integration", tools: "REST APIs, Retrofit, Firebase Crashlytics, Google Analytics" },
              { group: "AI", tools: "GitHub Copilot, Claude Code" },
              { group: "DevOps", tools: "Azure DevOps, CI/CD, Git" },
              { group: "Workflow", tools: "Agile Development" }
            ].each do |row| %>
              <li class="flex gap-3">
                <span class="mt-2 h-1.5 w-1.5 flex-none rounded-full bg-[#e35c2b]"></span>
                <div>
                  <p class="text-sm font-bold text-[#1a1a1a]"><%= row[:group] %>:</p>
                  <p class="text-sm text-gray-600"><%= row[:tools] %></p>
                </div>
              </li>
            <% end %>
          </ul>
        </div>
      </div>
    </section>

    <%# ===================== Projects ===================== %>
    <section id="projects" class="flex min-h-screen snap-start scroll-mt-6 flex-col justify-center py-20">
      <div class="mb-4 text-center">
        <h2 class="text-4xl font-extrabold tracking-tight text-[#1a1a1a] sm:text-5xl">Projects</h2>
      </div>
      <div class="mx-auto mb-16 h-16 w-[2px] bg-[#e35c2b]"></div>

      <div class="space-y-24">
        <% [
          {
            title: "Baking Recipe Keeper",
            tags: ["Kotlin", "Jetpack Compose", "MVVM", "Room"],
            desc: "A warm, offline-first Android app to save, scale, and follow baking recipes. Live serving & unit conversion, favorites and tags, shopping lists, a photo/video gallery, and backup & restore — built with Jetpack Compose, MVVM + StateFlow, and Room.",
            github: "https://github.com/lfigueras/Baking-Recipe-Keeper",
            live: "https://github.com/lfigueras/Baking-Recipe-Keeper/releases/download/v1.1/BakingRecipeKeeper-v1.1.apk",
            live_label: "Download APK",
            image: "baking-recipe-keeper-screen.jpg",
            mobile: true,
            color: "e35c2b"
          },
          {
            title: "GWeather",
            tags: ["Kotlin", "Jetpack Compose", "Retrofit", "Room"],
            desc: "A real-time Android weather app built with Jetpack Compose and MVVM that pulls live forecasts from the OpenWeather API (Retrofit/Moshi), with location services and a locally stored history of weather reports in Room.",
            github: "https://github.com/lfigueras/GWeather",
            live: "https://github.com/lfigueras/GWeather/releases/download/v0.1.0/Gweather-v0.1.0.apk",
            live_label: "Download APK",
            image: "gweather.png",
            mobile: true,
            color: "86d0c9"
          },
          {
            title: "SeatMate PH",
            tags: ["Ruby on Rails", "Hotwire", "Tailwind CSS", "Production"],
            desc: "A responsive marketing site for a van-rental and land-transfer business, built with Ruby on Rails and Hotwire (Turbo + Stimulus). Features a step-by-step booking flow, route-based pricing, and Messenger lead capture — live in production.",
            github: "https://github.com/lfigueras/seatmate-ph",
            live: "https://seatmate-ph.com/",
            live_label: "Visit Site",
            image: "vanrental.png",
            color: "f6c453"
          },
          {
            title: "Budgety",
            tags: ["JavaScript", "HTML", "CSS"],
            desc: "A budgeting web app for tracking income and expenses with automatic balance and percentage calculations. Built in vanilla JavaScript using the module pattern with a clean, DOM-driven UI.",
            github: "https://github.com/lfigueras/Budgety-JS",
            live: "https://lfigueras.github.io/Budgety-JS/",
            live_label: "Live Demo",
            image: "budgetcalculator.png",
            color: "9ab7f6"
          }
        ].each_with_index do |project, i| %>
          <div class="grid items-center gap-10 lg:grid-cols-2">
            <%# Text %>
            <div class="<%= "lg:order-2" if i.odd? %>">
              <h3 class="text-2xl font-extrabold tracking-tight text-[#1a1a1a]"><%= project[:title] %></h3>
              <div class="mt-4 flex flex-wrap gap-2">
                <% project[:tags].each do |tag| %>
                  <span class="border border-[#1a1a1a]/20 px-3 py-1 text-xs font-semibold text-[#1a1a1a]"><%= tag %></span>
                <% end %>
              </div>
              <p class="mt-5 max-w-md text-sm leading-relaxed text-gray-600"><%= project[:desc] %></p>
              <div class="mt-7 flex flex-wrap items-center gap-6">
                <% if project[:github] %>
                  <a href="<%= project[:github] %>" target="_blank" rel="noopener" class="bg-[#e35c2b] px-6 py-3 text-sm font-semibold text-white hover:bg-[#cf4f22]">View GitHub</a>
                <% end %>
                <% if project[:live] %>
                  <% if project[:github] %>
                    <a href="<%= project[:live] %>" target="_blank" rel="noopener" class="inline-flex items-center gap-1 border-b-2 border-[#1a1a1a] pb-0.5 text-sm font-semibold text-[#1a1a1a] hover:border-[#e35c2b] hover:text-[#e35c2b]">
                      <%= project[:live_label] || "View project" %>
                      <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7M7 7h10v10"/></svg>
                    </a>
                  <% else %>
                    <a href="<%= project[:live] %>" target="_blank" rel="noopener" class="bg-[#e35c2b] px-6 py-3 text-sm font-semibold text-white hover:bg-[#cf4f22]"><%= project[:live_label] || "View project" %></a>
                  <% end %>
                <% end %>
              </div>
            </div>
            <%# Image %>
            <div class="<%= "lg:order-1" if i.odd? %> <%= "flex justify-center" if project[:mobile] %>">
              <% if project[:mobile] %>
                <div class="rounded-[2rem] border-[7px] border-[#1a1a1a] bg-[#1a1a1a] p-1">
                  <% if project[:image] %>
                    <%= image_tag project[:image], alt: project[:title], class: "h-[500px] w-auto rounded-[1.5rem] object-cover" %>
                  <% else %>
                    <img src="https://placehold.co/320x640/<%= project[:color] %>/f6eee4?text=<%= CGI.escape(project[:title]) %>" alt="<%= project[:title] %>" class="h-[500px] w-auto rounded-[1.5rem] object-cover">
                  <% end %>
                </div>
              <% else %>
                <div class="overflow-hidden rounded-2xl">
                  <% if project[:image] %>
                    <%= image_tag project[:image], alt: project[:title], class: "block h-auto w-full" %>
                  <% else %>
                    <img src="https://placehold.co/600x400/<%= project[:color] %>/f6eee4?text=<%= CGI.escape(project[:title]) %>" alt="<%= project[:title] %>" class="aspect-video h-full w-full object-cover">
                  <% end %>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </section>
  </div>

  <%# ===================== Contact + footer (one viewport) ===================== %>
  <section id="contact" class="flex min-h-screen snap-start flex-col">
    <div class="mx-auto flex w-full max-w-6xl flex-1 flex-col justify-center px-6 py-16 sm:px-10">
      <p class="mb-8 flex items-center gap-3 text-sm font-semibold text-[#1a1a1a]">
        <span class="h-[2px] w-12 bg-[#e35c2b]"></span> Contacts
      </p>

      <%= form_with url: contact_path, method: :post, class: "grid gap-12 lg:grid-cols-2" do |f| %>
        <%# Left: heading + submit %>
        <div>
          <h2 class="text-4xl font-extrabold leading-tight tracking-tight text-[#1a1a1a] sm:text-5xl">Have a project?<br>Let&rsquo;s talk!</h2>
          <%= f.submit "Submit", class: "mt-10 cursor-pointer bg-[#e35c2b] px-10 py-3 text-sm font-semibold text-white hover:bg-[#cf4f22]" %>

          <%# Minimal direct links %>
          <div class="mt-10 flex items-center gap-6 text-[#1a1a1a]">
            <a href="mailto:lovelyfigueras@gmail.com" aria-label="Email" class="hover:text-[#e35c2b]">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor"><path d="M20 4H4a2 2 0 00-2 2v12a2 2 0 002 2h16a2 2 0 002-2V6a2 2 0 00-2-2zm0 4-8 5-8-5V6l8 5 8-5v2z"/></svg>
            </a>
            <a href="https://github.com/lfigueras" target="_blank" rel="noopener" aria-label="GitHub" class="hover:text-[#e35c2b]">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.58 2 12.25c0 4.53 2.87 8.37 6.85 9.73.5.1.68-.22.68-.49 0-.24-.01-.88-.01-1.73-2.78.62-3.37-1.21-3.37-1.21-.46-1.18-1.11-1.49-1.11-1.49-.91-.64.07-.62.07-.62 1 .07 1.53 1.05 1.53 1.05.89 1.57 2.34 1.11 2.91.85.09-.66.35-1.11.63-1.37-2.22-.26-4.56-1.14-4.56-5.05 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.7 0 0 .84-.28 2.75 1.05A9.3 9.3 0 0112 6.84c.85 0 1.71.12 2.51.34 1.91-1.33 2.75-1.05 2.75-1.05.55 1.4.2 2.44.1 2.7.64.72 1.03 1.63 1.03 2.75 0 3.92-2.34 4.78-4.57 5.04.36.32.68.94.68 1.9 0 1.37-.01 2.47-.01 2.81 0 .27.18.59.69.49A10.02 10.02 0 0022 12.25C22 6.58 17.52 2 12 2z"/></svg>
            </a>
            <a href="https://www.linkedin.com/in/lovely-joy-figueras" target="_blank" rel="noopener" aria-label="LinkedIn" class="hover:text-[#e35c2b]">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor"><path d="M4.98 3.5a2.5 2.5 0 11-.02 5 2.5 2.5 0 01.02-5zM3 9h4v12H3zM9 9h3.8v1.64h.05c.53-1 1.82-2.05 3.75-2.05 4.01 0 4.75 2.64 4.75 6.07V21h-4v-5.4c0-1.29-.02-2.95-1.8-2.95-1.8 0-2.08 1.4-2.08 2.85V21H9z"/></svg>
            </a>
          </div>
        </div>

        <%# Right: underline fields %>
        <div class="space-y-8">
          <div>
            <%= f.label :name, class: "mb-1 block text-sm font-medium text-[#1a1a1a]" %>
            <%= f.text_field :name, required: true, class: "w-full border-0 border-b border-[#1a1a1a]/30 bg-transparent py-2 text-sm text-[#1a1a1a] focus:border-[#e35c2b] focus:outline-none focus:ring-0" %>
          </div>
          <div>
            <%= f.label :email, class: "mb-1 block text-sm font-medium text-[#1a1a1a]" %>
            <%= f.email_field :email, required: true, class: "w-full border-0 border-b border-[#1a1a1a]/30 bg-transparent py-2 text-sm text-[#1a1a1a] focus:border-[#e35c2b] focus:outline-none focus:ring-0" %>
          </div>
          <div>
            <%= f.label :message, class: "mb-1 block text-sm font-medium text-[#1a1a1a]" %>
            <%= f.text_area :message, rows: 3, required: true, class: "w-full resize-none border-0 border-b border-[#1a1a1a]/30 bg-transparent py-2 text-sm text-[#1a1a1a] focus:border-[#e35c2b] focus:outline-none focus:ring-0" %>
          </div>
        </div>
      <% end %>
    </div>

    <%# Footer (part of the contact page) %>
    <footer class="border-t border-[#1a1a1a]/10 bg-[#ece1d0] px-6 py-16 text-center">
      <p class="text-2xl font-extrabold tracking-tight text-[#1a1a1a]">Lovely Joy Figueras</p>
      <p class="mt-4 text-sm text-gray-500">Designed with love &mdash; all rights reserved &copy; <%= Date.current.year %>.</p>
  </section>
</div>
